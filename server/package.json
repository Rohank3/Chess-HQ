{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Authoritative real-time chess server: Express 5 + Socket.IO + PostgreSQL.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dry-run": "tsx src/db/migrate.ts --dry-run",
    "test": "node --import tsx --test-reporter spec --test src/db/migrate.test.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "chess.js": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.10",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
