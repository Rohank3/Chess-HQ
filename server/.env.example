NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess

JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
# Shorter TTL for guest tokens -- "play as guest" is a use-and-discard flow.
JWT_GUEST_TTL=2h

CLIENT_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Draw offer TTL in ms -- a pending offer is reaped after this window so
# an abandoned offer can't leave a game in "offer pending" limbo forever.
DRAW_OFFER_TTL_MS=30000

# Per-socket illegal-move threshold. A socket that pushes this many
# illegal/not-your-turn moves is force-disconnected. 5 is generous to clumsy
# humans, hostile to bots. Production keeps the default; override only to tune.
MAX_ILLEGAL_MOVES=5

# How many proxy hops sit in front of the server. Dev is 0 so req.ip is the
# direct socket peer; Render sets 1 (one trusted proxy) so req.ip reads the real
# client address out of X-Forwarded-For -- which the per-IP rate limiter keys on.
TRUST_PROXY_HOPS=0

LOG_LEVEL=info
