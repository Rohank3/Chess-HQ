NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess

JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
# Shorter TTL for guest tokens -- "play as guest" is a use-and-discard flow.
JWT_GUEST_TTL=2h

CLIENT_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Draw offer TTL in ms -- a pending offer is reaped after this window so
# an abandoned offer can't leave a game in "offer pending" limbo forever.
DRAW_OFFER_TTL_MS=30000

# Per-socket illegal-move threshold. A socket that pushes this many
# illegal/not-your-turn moves is force-disconnected. 5 is generous to clumsy
# humans, hostile to bots. Production keeps the default; override only to tune.
MAX_ILLEGAL_MOVES=5

# How many proxy hops sit in front of the server. Dev is 0 so req.ip is the
# direct socket peer; Render sets 1 (one trusted proxy) so req.ip reads the real
# client address out of X-Forwarded-For -- which the per-IP rate limiter keys on.
TRUST_PROXY_HOPS=0

LOG_LEVEL=info

# --- Outbound email (verification + password reset) -----------------------
# EMAIL_PROVIDER=none logs the message to the server console instead of
# sending (perfect for dev -- the link is click-through-able in the log).
# EMAIL_PROVIDER=resend sends via Resend's free tier (3,000/month, 100/day);
# set RESEND_API_KEY from https://resend.com/api-keys. NOTE: the shared
# onboarding@resend.dev sender can ONLY deliver to the email you registered
# Resend with -- sending to real users requires verifying a domain in Resend.
# EMAIL_PROVIDER=smtp sends via any SMTP server (Gmail is the zero-cost
# path: ~500 emails/day; see SMTP_* below).
EMAIL_PROVIDER=none
# From address on every message. Resend: onboarding@resend.dev until you
# verify a domain, then e.g. Chess-HQ <no-reply@yourdomain.com>. SMTP:
# the mailbox you authenticate as (or an alias it may send from).
EMAIL_FROM=Chess-HQ <onboarding@resend.dev>
RESEND_API_KEY=

# SMTP provider config (only used with EMAIL_PROVIDER=smtp).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password from
# Google Account > Security > 2-Step Verification > App passwords>.
# Any SMTP server works; for STARTTLS use port 587 with SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
