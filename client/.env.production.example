# Production environment template for the Chess-HQ frontend.
#
# These are Vite build-time variables -- they are read at `vite build` time and
# baked into the bundle, so they are per-deploy, not runtime. Set them in the
# Netlify dashboard (Site settings > Environment variables) rather than committing
# a real .env.production (which is gitignored anyway).
#
# Both vars point at the Render backend's public HTTPS origin. In dev these stay
# empty so the Vite proxy (vite.config.ts) forwards /api and /socket.io to
# localhost:4000; in production they must be the absolute backend origin because
# the dev proxy no longer exists once the bundle is served statically by Netlify.
#
#   - VITE_API_URL  -> axios baseURL consumed by src/api/http.ts
#   - VITE_SOCKET_URL -> Socket.IO `io(url, ...)` origin consumed by src/socket/socket.ts
#
# Replace the placeholder below with your own Render web-service URL (e.g.
# https://chess-server-xxxx.onrender.com) and set both to the same value -- the
# REST API and the Socket.IO server share one Express server on one origin.

VITE_API_URL=https://chess-server.onrender.com
VITE_SOCKET_URL=https://chess-server.onrender.com
